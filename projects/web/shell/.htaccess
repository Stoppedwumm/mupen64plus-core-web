# Apache configuration for the Mupen64Plus web build

# WebAssembly must be served with the right MIME type to be streamed/compiled
AddType application/wasm .wasm
AddType application/javascript .js

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/wasm application/javascript text/html
</IfModule>

# Always revalidate, so an updated build is picked up on the next load
<IfModule mod_headers.c>
    <FilesMatch "\.(wasm|js|html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

DirectoryIndex index.html
